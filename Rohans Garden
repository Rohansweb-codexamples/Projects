  <script>
  // Ticker animation
  const ticker = document.getElementById('ticker');
  let tickerPos = 0;
  const tickerContent = ticker.innerHTML;
  ticker.innerHTML = tickerContent + tickerContent;
  function animateTicker() {
    tickerPos -= 0.5;
    if (Math.abs(tickerPos) >= ticker.scrollWidth / 2) tickerPos = 0;
    ticker.style.transform = `translateX(${tickerPos}px)`;
    requestAnimationFrame(animateTicker);
  }
  animateTicker();

  // Intersection observer for scroll animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.style.opacity = '1';
        e.target.style.transform = 'translateY(0)';
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.plant-card').forEach(card => {
    card.style.opacity = '0';
    card.style.transform = 'translateY(30px)';
    card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
    observer.observe(card);
  });

  // Element SDK
  const defaultConfig = {
    hero_title: 'The Botanical<br><span style="color:#4ade80;font-style:italic;">World</span>',
    hero_subtitle: 'Discover the quiet elegance of plant life — from towering canopies to delicate ferns unfurling at dawn.',
    section_title: 'Featured Species',
    background_color: '#0a1a0f',
    surface_color: '#132a1a',
    text_color: '#e2e8f0',
    accent_color: '#4ade80',
    secondary_accent: '#fb7185',
    font_family: 'Playfair Display',
    font_size: 16
  };

  async function onConfigChange(config) {
    const c = { ...defaultConfig, ...config };
    document.getElementById('hero-title').innerHTML = c.hero_title;
    document.getElementById('hero-subtitle').textContent = c.hero_subtitle;
    document.getElementById('section-title').textContent = c.section_title;

    // Apply font
    const font = c.font_family || defaultConfig.font_family;
    document.querySelectorAll('h1,h2,h3').forEach(el => {
      el.style.fontFamily = `${font}, Playfair Display, serif`;
    });

    // Apply font size scaling
    const base = c.font_size || defaultConfig.font_size;
    document.querySelectorAll('p').forEach(el => {
      el.style.fontSize = `${base * 0.9}px`;
    });

    // Apply colors
    document.getElementById('app').style.background = c.background_color;
    document.querySelectorAll('h1,h2,h3').forEach(el => el.style.color = c.text_color);
    document.querySelectorAll('.plant-card').forEach(el => {
      el.style.background = `linear-gradient(145deg, ${c.surface_color}, ${c.surface_color}dd)`;
    });
  }

  function mapToCapabilities(config) {
    const c = { ...defaultConfig, ...config };
    function makeColor(key) {
      return {
        get: () => c[key] || defaultConfig[key],
        set: (v) => { c[key] = v; window.elementSdk.setConfig({ [key]: v }); }
      };
    }
    return {
      recolorables: [
        makeColor('background_color'),
        makeColor('surface_color'),
        makeColor('text_color'),
        makeColor('accent_color'),
        makeColor('secondary_accent')
      ],
      borderables: [],
      fontEditable: {
        get: () => c.font_family || defaultConfig.font_family,
        set: (v) => { c.font_family = v; window.elementSdk.setConfig({ font_family: v }); }
      },
      fontSizeable: {
        get: () => c.font_size || defaultConfig.font_size,
        set: (v) => { c.font_size = v; window.elementSdk.setConfig({ font_size: v }); }
      }
    };
  }

  function mapToEditPanelValues(config) {
    const c = { ...defaultConfig, ...config };
    return new Map([
      ['hero_title', c.hero_title || defaultConfig.hero_title],
      ['hero_subtitle', c.hero_subtitle || defaultConfig.hero_subtitle],
      ['section_title', c.section_title || defaultConfig.section_title]
    ]);
  }

  window.elementSdk.init({ defaultConfig, onConfigChange, mapToCapabilities, mapToEditPanelValues });

  lucide.createIcons();
</script>
