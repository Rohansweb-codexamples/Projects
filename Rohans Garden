  <style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  @keyframes float { 0%,100%{ transform: translateY(0) rotate(0deg); } 50%{ transform: translateY(-18px) rotate(3deg); } }
  @keyframes floatSlow { 0%,100%{ transform: translateY(0) rotate(0deg); } 50%{ transform: translateY(-12px) rotate(-2deg); } }
  @keyframes sway { 0%,100%{ transform: rotate(-3deg); } 50%{ transform: rotate(3deg); } }
  @keyframes growUp { 0%{ transform: scaleY(0); opacity:0; } 100%{ transform: scaleY(1); opacity:1; } }
  @keyframes fadeSlideUp { 0%{ opacity:0; transform: translateY(40px); } 100%{ opacity:1; transform: translateY(0); } }
  @keyframes pulse { 0%,100%{ transform: scale(1); } 50%{ transform: scale(1.05); } }
